#!/bin/sh
# Open your coding agent in a folder with a task as its first message.
#
#   bin/ask-agent <folder> <prompt>
#
# The agent is $AGENT, else Omarchy's default agent, else claude. Claude Code and Codex take
# the prompt on the command line and stay open for the rest of the conversation; any other
# agent gets the prompt printed, to paste in.
set -eu

folder=$1
prompt=$2
agent=${AGENT:-}
if [ -z "$agent" ] && [ -r "$HOME/.config/omarchy/defaults/agent" ]; then
  agent=$(awk '{ print $1; exit }' "$HOME/.config/omarchy/defaults/agent")
fi
agent=${agent:-claude}

cd "$folder"
case "$agent" in
  claude|codex)
    if command -v "$agent" >/dev/null 2>&1; then
      exec "$agent" "$prompt"
    fi
    ;;
esac
printf '\n%s is not something this script can start with a prompt.\nOpen your agent in %s and give it this:\n\n%s\n\n' "$agent" "$folder" "$prompt"
